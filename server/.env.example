# ---------- Server ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://172.48.0.116:5175
# Time zone offset (minutes) used when parsing pasted date-times without a zone (Thailand = 420)
APP_TZ_OFFSET_MINUTES=420

# ---------- SQL Server ----------
DB_HOST=172.48.0.116
DB_PORT=1433
# For a named instance such as SQLEXPRESS set DB_INSTANCE and DB_PORT is ignored
DB_INSTANCE=
DB_NAME=DataSheetPro
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_ENCRYPT=false
DB_TRUST_CERT=true
DB_POOL_MIN=2
DB_POOL_MAX=30

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=1h
REFRESH_TOKEN_DAYS=7
# Secure refresh cookie (default true in production). Set false only if served over plain HTTP on a non-172.48.0.116 host.
COOKIE_SECURE=

# ---------- Social login (optional) ----------
# Public URL users type in the browser. Redirect URIs to register at the providers:
#   {PUBLIC_URL}/api/auth/oauth/google/callback      {PUBLIC_URL}/api/auth/oauth/microsoft/callback
# Google requires https (or localhost) redirect URIs, so use a hostname with a certificate rather than a bare IP.
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# common | organizations | consumers | your tenant id / domain (a specific tenant lets e-mail match existing users)
MS_TENANT=common
# false = someone without an account who signs in with Microsoft / Google gets the "ขอสร้างบัญชี" form (an admin approves it,
#         users page → คำขอสร้างบัญชี); true = create a "user" account on first login without approval
OAUTH_AUTO_CREATE=false
# Comma separated e-mail domains allowed to use social login, e.g. thaiunion.co.th (empty = any)
OAUTH_ALLOWED_DOMAINS=

# ---------- Monitor page (optional) ----------
# Cloudflare's own request counts on the admin Monitor page: API token with "Zone · Analytics · Read" + the zone id
CF_API_TOKEN=
CF_ZONE_ID=

# ---------- Behaviour ----------
RATE_LIMIT_PER_MIN=600
# true  = users see names of files/folders they cannot open (lock icon + request access)
# false = hidden unless the user has access somewhere in the path
SHOW_LOCKED_ITEMS=true
UPLOAD_DIR=uploads
# Archived (signed) PDFs — NOT served publicly; only through the authenticated /api/exports/:id/download
ARCHIVE_DIR=archive
ARCHIVE_MAX_MB=50
MAX_UPLOAD_MB=15
TRASH_RETENTION_DAYS=30
# Serve the built React app from this server (e.g. ../client/dist). Leave empty in development.
SERVE_CLIENT_DIR=

# ---------- Seed ----------
SEED_ADMIN_PASSWORD=Admin@123

# LINE alerts (Messaging API channel of your LINE Official Account) — never commit real values
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# LINE_ALERT_INTERVAL_SEC=60
# LINE_ALERT_WINDOW_DAYS=7

# RFID gateway: connects to the readers of "อุปกรณ์". A reader accepts ONE connection — enable on ONE server process,
# and never while PFCM's RFIDc1.js is connected to the same reader.
# GATEWAY_ENABLED=1
# DEVICE_DEBOUNCE_MS=5000

# ---- Two servers behind a load balancer (docs/HA.md) -------------------------------------------------
# NODE_ID=app116                         # a name for this server (shown in /api/health)
# REDIS_URL=redis://172.48.0.116:6379    # lets the servers hear each other (live updates, cache clearing). Empty = one server
# UPLOAD_DIR=\\fileserver\dochub\uploads # BOTH servers must point to the SAME shared folder
# ARCHIVE_DIR=\\fileserver\dochub\archive
# JWT_SECRET=...                         # the SAME value on both servers
# PUBLIC_URL=http://<load balancer address>
# ---- SQL Server Always On: DB_HOST = the availability group LISTENER name
# DB_MULTI_SUBNET_FAILOVER=true
